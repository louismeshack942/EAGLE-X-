# EAGLE-X environment template
# Copy to `.env`, fill in real values, and NEVER commit `.env`.

# ---- App ----
ENV=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Database ----
# Dev fallback (no external services needed): SQLite file.
DATABASE_URL=sqlite:///./eaglex_dev.db
# Production (PostgreSQL via psycopg):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/eaglex

# ---- Redis (used for caching/sessions in later phases; dev falls back) ----
REDIS_URL=redis://localhost:6379/0

# ---- Frontend (served by the single backend service) ----
# Path to the exported Next.js build directory.
FRONTEND_DIR=../frontend/out

# ---- Deriv OAuth2 (Authorization Code + PKCE) ----
# Get a client_id + secret by registering an app at developers.deriv.com.
# NO passwords are ever stored or used.
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_CLIENT_SECRET=
DERIV_OAUTH_REDIRECT_URI=http://localhost:8000/auth/deriv/callback
DERIV_OAUTH_AUTHORIZE_URL=https://oauth.deriv.com/oauth2/authorize
DERIV_OAUTH_TOKEN_URL=https://api.deriv.com/oauth2/token
# Deriv websocket (public endpoints) — used for unauthenticated ticks when no OAuth.
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_REST_BASE=https://api.derivws.com/trading/v1

# ---- Security ----
# Strong random value in production, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-in-production
# Session lifetime (seconds)
SESSION_TTL_SECONDS=43200
# Set to true when serving over HTTPS only.
COOKIE_SECURE=false